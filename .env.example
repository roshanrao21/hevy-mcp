# Local stdio mode
HEVY_API_KEY=replace-with-your-hevy-pro-api-key

# Remote HTTP mode
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000

# Optional gateway token protecting the public MCP endpoint.
# Clients send: Authorization: Bearer <MCP_ACCESS_TOKEN>
MCP_ACCESS_TOKEN=replace-with-a-long-random-value

# In shared remote mode, each client should send its Hevy key in:
# X-Hevy-API-Key: <their-key>
ALLOW_HEADER_HEVY_KEY=true

# Mutating tools are disabled unless this is explicitly true.
ALLOW_WRITES=false

# Safety and reliability
HEVY_BASE_URL=https://api.hevyapp.com
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_SIZE=10
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
